<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomEditToolBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/ll_pdf_edit_bottom_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Thickness Slider and Color Picker for Drawing Mode -->
        <LinearLayout
            android:id="@+id/pdf_bottom_draw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- Header with Close/Minimize button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:paddingHorizontal="16dp">

                <TextView
                    style="@style/FontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="STROKE"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_close_draw"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_close_new"
                    app:tint="#111827" />
            </RelativeLayout>

            <!-- Thickness Slider Section -->
            <LinearLayout
                android:id="@+id/rl_paint_xp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="22dp"
                android:layout_marginBottom="8dp">

                <com.arkay.gkinhindi.ui.customviews.seekbar.RangeSeekBar
                    android:id="@+id/thickness_seekBar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    app:rsb_gravity="center"
                    app:rsb_max="50"
                    app:rsb_min="0.25"
                    app:rsb_mode="single"
                    app:rsb_progress_color="@color/selected_tab_blue"
                    app:rsb_progress_default_color="#E2E8F0"
                    app:rsb_progress_height="6dp"
                    app:rsb_progress_radius="3dp"
                    app:rsb_thumb_height="20dp"
                    app:rsb_thumb_width="20dp"
                    app:rsb_thumb_drawable="@drawable/bg_circle_thumb" />

                <!-- Badge style displaying size -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/sizeTv"
                    style="@style/FontBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_language_badge"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="2px"
                    android:textColor="@color/selected_tab_blue"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Color Picker list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerColor"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:clipToPadding="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_color" />
        </LinearLayout>

        <!-- Edit Tools Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/white"
            android:orientation="horizontal">

            <!-- Draw -->
            <com.arkay.gkinhindi.ui.customviews.EditBtn
                android:id="@+id/btnDrawNew"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:TextEdt="Draw"
                app:ImageEdt="@drawable/ic_edit" />

            <!-- Highlight -->
            <com.arkay.gkinhindi.ui.customviews.EditBtn
                android:id="@+id/btnHighlight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:TextEdt="Highlight"
                app:ImageEdt="@drawable/ic_highlight" />

            <!-- Text -->
            <com.arkay.gkinhindi.ui.customviews.EditBtn
                android:id="@+id/btnText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:TextEdt="Text"
                app:ImageEdt="@drawable/ic_edit_font_aa" />

            <!-- Stickers -->
            <com.arkay.gkinhindi.ui.customviews.EditBtn
                android:id="@+id/btn_insert_image"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:TextEdt="Stickers"
                app:ImageEdt="@drawable/ic_edit_stickers" />

            <!-- Sign -->
            <com.arkay.gkinhindi.ui.customviews.EditBtn
                android:id="@+id/btn_signature"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:TextEdt="Sign"
                app:ImageEdt="@drawable/ic_sign" />

            <!-- Erase -->
            <com.arkay.gkinhindi.ui.customviews.EditBtn
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:TextEdt="Erase"
                app:ImageEdt="@drawable/ic_eraser" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>