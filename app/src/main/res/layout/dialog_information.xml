<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="24dp"
    android:background="@drawable/bg_dialog_confirm_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Header Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Header Content: Badge + Title Group -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Icon Badge -->
            <FrameLayout
                android:id="@+id/icon_container"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_dialog_icon_badge">

                <!-- Document Preview Card -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center">

                    <!-- Base document frame with fold -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_document_base" />

                    <!-- Extension overlay banner -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_extension_badge"
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_gravity="bottom"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_doc_icon_banner"
                        android:gravity="center"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold" />

                </FrameLayout>
            </FrameLayout>

            <!-- Title & Subtitle Group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_title_doc_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="@string/info_label"
                    android:textColor="@color/app_primary_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:text="View complete information about this file"
                    android:textColor="@color/app_normal_text"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Close Button -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_dialog_close_btn"
            android:contentDescription="@null"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            app:srcCompat="@drawable/ic_close"
            app:tint="#5E6C84"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Metadata List Container -->
    <LinearLayout
        android:id="@+id/ll_metadata_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <!-- Name Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_info_row"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <!-- Circular Icon Badge -->
            <FrameLayout
                android:id="@+id/badge_name"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_info_badge_blue">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_doc" />
            </FrameLayout>

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/info_name"
                android:textColor="#5E6C84"
                android:textSize="14sp" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/app_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Size Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_info_row"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <!-- Circular Icon Badge -->
            <FrameLayout
                android:id="@+id/badge_size"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_info_badge_green">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_size" />
            </FrameLayout>

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/info_size"
                android:textColor="#5E6C84"
                android:textSize="14sp" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_file_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/app_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Path Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_info_row"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <!-- Circular Icon Badge -->
            <FrameLayout
                android:id="@+id/badge_path"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_info_badge_purple">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_path" />
            </FrameLayout>

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/info_path"
                android:textColor="#5E6C84"
                android:textSize="14sp" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_file_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="end"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/app_normal_text"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Last Modified Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_dialog_info_row"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <!-- Circular Icon Badge -->
            <FrameLayout
                android:id="@+id/badge_modified"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_info_badge_orange">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_calendar" />
            </FrameLayout>

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/info_last_modified"
                android:textColor="#5E6C84"
                android:textSize="14sp" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_last_modified_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/app_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Keep these invisible fields for safety -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_last_view_time_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_last_view_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

    <!-- OK Action Button -->
    <LinearLayout
        android:id="@+id/btn_confirm_sort"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_dialog_btn_primary"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle_outline"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_medium"
            android:text="@string/action_ok"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
