<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Current Location Header Label -->
    <TextView
        android:id="@+id/tv_file_name_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/inter_bold"
        android:text="File Name"
        android:textColor="@color/colorAccent"
        android:textSize="13sp" />

    <!-- File Name Input Wrapper -->
    <LinearLayout
        android:id="@+id/edit_text_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_file"
            app:tint="@color/colorAccent"
            android:visibility="gone"/>

        <com.artifex.sonui.editor.SOEditText
            android:id="@+id/edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:fontFamily="@font/inter_medium"
            android:hint="@string/editor_file_name"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:minHeight="44dp"
            android:textColor="@color/app_primary_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Current Location Header Label -->
    <TextView
        android:id="@+id/tv_current_location_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/inter_bold"
        android:text="Current location"
        android:textColor="@color/colorAccent"
        android:textSize="13sp" />

    <!-- Current Location: breadcrumb + Browse (+) button side-by-side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="15dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/breadcrumb_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_info_row"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">
            <include layout="@layout/view_breadcrumb_path" />
        </FrameLayout>
    </LinearLayout>

    <!-- Picked-path row: shown after system folder picker returns a path -->
    <LinearLayout
        android:id="@+id/ll_picked_path_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:background="@drawable/bg_dialog_input_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_nav_files"
            app:tint="@color/colorAccent" />

        <TextView
            android:id="@+id/et_picked_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/inter_regular"
            android:hint="Folder path…"
            android:singleLine="true"
            android:ellipsize="start"
            android:textColor="@color/app_primary_text"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btn_edit_picked_path"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_edit"
            android:contentDescription="Edit path"
            app:tint="@color/app_text_gray"
            android:visibility="gone"/>

        <!-- + Browse button -->
        <ImageView
            android:id="@+id/btn_browse_folder"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_add_path"
            android:tint="@color/colorAccent"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Other Locations Header Label -->
    <TextView
        android:id="@+id/tv_other_locations_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="15dp"
        android:fontFamily="@font/inter_bold"
        android:text="Other locations"
        android:textColor="@color/app_text_gray"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Explorer ListView Container -->
    <RelativeLayout
        android:id="@+id/rlContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <com.artifex.sonui.ExplorerListView
            android:id="@+id/fileListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:choiceMode="singleChoice"
            android:divider="#F0F2F5"
            android:dividerHeight="1dp"
            android:paddingHorizontal="4dp"
            android:splitMotionEvents="false" />

        <com.artifex.sonui.editor.SOTextView
            android:id="@+id/no_documents_found"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/editor_no_documents_found"
            android:textColor="@color/app_text_gray"
            android:textSize="15sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/enumerate_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/colorAccent"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Info/Warning Banner Layout -->
    <LinearLayout
        android:id="@+id/info_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dialog_info_banner"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_dialog_info_icon"
            app:tint="#D97706" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="Your document will be saved in the selected location."
            android:textColor="#92400E"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Cancel and Save Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="4dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_secondary"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/action_cancel"
            android:textAllCaps="false"
            android:textColor="@color/app_primary_text"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/save_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_save_rounded"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/editor_save"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
