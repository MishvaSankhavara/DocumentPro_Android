<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/header"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/toolbar_document_main" />
        <include layout="@layout/toolbar_search" />
        <include layout="@layout/toolbar_document_edit" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@id/doc_inner_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_container"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/doc_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_colorWhite"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/doc_note_editor"
            android:layout_width="@dimen/sodk_editor_note_editor_width"
            android:layout_height="wrap_content"
            android:background="@color/editor_pdf_note_color"
            android:orientation="vertical"
            android:visibility="gone">

            <com.artifex.sonui.editor.SOTextView
                android:id="@+id/doc_note_editor_author"
                style="@style/sodk_editor_note_editor_textview_style"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.artifex.sonui.editor.SOTextView
                android:id="@+id/doc_note_editor_date"
                style="@style/sodk_editor_note_editor_textview_style"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp" />

            <com.artifex.sonui.editor.SOEditText
                android:id="@+id/doc_note_editor_text"
                style="@style/sodk_editor_note_editor_textview_style"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:imeOptions="flagNoFullscreen"
                android:minLines="6"
                android:text="" />
        </LinearLayout>


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_full_screen"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="13dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/shape_page_num_bg"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp"
            android:src="@drawable/fullscreen"
            android:tint="@color/black" />

        <include
            layout="@layout/layout_undo_redo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="13dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <include
            layout="@layout/layout_button_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="13dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent" />

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/shadow_bottom"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginBottom="50dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toTopOf="@id/bottom_container"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@android:color/transparent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            android:id="@+id/bottom_view"
            layout="@layout/document_view_bottom_other"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>