<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_confirm_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <!-- Circular Folder Illustration Badge -->
        <FrameLayout
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog_icon_badge">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_files"
                app:tint="@color/colorAccent" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/app_primary_text"
            android:textSize="20sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="Choose a location to save your document"
            android:textColor="@color/app_text_gray"
            android:textSize="14sp" />

        <com.artifex.sonui.FileBrowser
            android:id="@+id/file_browser"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_360sdp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</LinearLayout>